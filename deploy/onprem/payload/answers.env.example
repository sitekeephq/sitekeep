# Answers file for unattended installation: cp answers.env.example answers.env, edit it, then
#   sudo ./install.sh --answers answers.env
# Values left empty use their defaults.

CDE_DOMAIN=cde.example.local
# auto (public domain name + internet) | internal (internal network) | files (your own certificate) | off
CDE_TLS=internal
# For CDE_TLS=files:
# CDE_TLS_CERT=/etc/ssl/example/cde.crt
# CDE_TLS_KEY=/etc/ssl/example/cde.key

ADMIN_EMAIL=it@example.com
# If empty, a strong password is generated and shown once at the end of the installation.
ADMIN_PASSWORD=

CDE_USERS=50
# Default user interface language: tr | en
CDE_LANGUAGE=en
CDE_BACKUP_TIME=02:30
CDE_BACKUP_KEEP=14

# Directories and ports (defaults):
# CDE_HOME=/opt/sitekeep
# CDE_DATA=/var/lib/sitekeep
# CDE_HTTP_PORT=80
# CDE_HTTPS_PORT=443
