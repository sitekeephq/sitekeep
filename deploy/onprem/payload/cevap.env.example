# Sorusuz kurulum için cevap dosyası: cp cevap.env.example cevap.env, düzenleyin,
#   sudo ./install.sh --answers cevap.env
# Boş bırakılan değerin varsayılanı kullanılır.

CDE_DOMAIN=cde.sirket.local
# auto (herkese açık alan adı + internet) | internal (iç ağ) | files (kendi sertifikanız) | off
CDE_TLS=internal
# CDE_TLS=files için:
# CDE_TLS_CERT=/etc/ssl/sirket/cde.crt
# CDE_TLS_KEY=/etc/ssl/sirket/cde.key

ADMIN_EMAIL=bt@sirket.com.tr
# Boşsa güçlü bir şifre üretilir ve kurulum sonunda bir kez gösterilir.
ADMIN_PASSWORD=

CDE_USERS=50
CDE_LANGUAGE=tr
CDE_BACKUP_TIME=02:30
CDE_BACKUP_KEEP=14

# Dizinler ve portlar (varsayılanlar):
# CDE_HOME=/opt/sitekeep
# CDE_DATA=/var/lib/sitekeep
# CDE_HTTP_PORT=80
# CDE_HTTPS_PORT=443
