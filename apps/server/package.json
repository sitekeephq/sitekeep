    "dxf-viewer": "^1.0.49",
    "fastify": "^5.12.5",
    "i18next": "26.4.2",
    "jose": "^6.2.12",
    "nodemailer": "^10.0.16",
    "opentype.js": "^1.3.4",
    "pdf-lib": "^1.17.1",
    "pdfjs-dist": "6.3.289",
    "pg": "^8.23.1",
    "qrcode-generator": "2.0.4",
    "tesseract.js": "7.0.0",
    "three": "^0.186.1",
