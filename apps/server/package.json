    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "scenarios": "tsx scripts/run-scenarios.ts",
    "db:generate": "drizzle-kit generate",
    "audit:verify": "tsx src/scripts/audit-verify.ts",
