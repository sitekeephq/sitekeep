{
  "name": "@sitekeep/server",
  "version": "0.1.0",
  "license": "AGPL-3.0-only",
  "private": true,
  "type": "module",
  "main": "dist/index.js",
  "scripts": {
    "dev": "tsx watch --env-file=.env.development src/index.ts",
    "build": "tsc -p tsconfig.json && node scripts/copy-locales.mjs",
    "start": "node dist/index.js",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "scenarios": "tsx scripts/run-scenarios.ts",
    "db:generate": "drizzle-kit generate",
    "import:autodesk": "tsx src/scripts/import-autodesk.ts",
    "seed:showcase": "tsx src/scripts/seed-project-showcase.ts",
    "seed:load": "tsx --env-file=.env.development src/scripts/seed-ui-load.ts",
    "seed:load:mine": "tsx --env-file=.env.development src/scripts/assign-ui-load.ts"
  },
  "dependencies": {
    "@sitekeep/cde-tools": "0.1.0",
    "@sitekeep/shared": "0.1.0",
    "@electric-sql/pglite": "^0.5.8",
    "@fastify/cookie": "^11.1.3",
    "@fastify/multipart": "^10.1.3",
    "@fastify/static": "^10.1.6",
    "@fontsource/noto-sans": "^5.3.0",
    "@modelcontextprotocol/sdk": "^1.32.1",
    "@pdf-lib/fontkit": "^1.1.1",
    "@thatopen/fragments": "^3.4.8",
    "drizzle-orm": "^0.45.4",
    "dxf-viewer": "^1.0.49",
    "fastify": "^5.12.5",
    "i18next": "26.4.2",
    "nodemailer": "^10.0.16",
    "opentype.js": "^1.3.4",
    "pdf-lib": "^1.17.1",
    "pdfjs-dist": "6.3.289",
    "pg": "^8.23.1",
    "three": "^0.186.1",
    "web-ifc": "^0.0.78",
    "xlsx": "https://cdn.sheetjs.com/xlsx-0.20.3/xlsx-0.20.3.tgz",
    "yauzl": "^3.4.0",
    "yazl": "^3.3.1",
    "zod": "^4.6.5"
  },
  "optionalDependencies": {
    "@7dimensions-project/sitekeep-ee-ai": "0.4.1",
    "@7dimensions-project/sitekeep-ee-connect": "0.3.3",
    "@7dimensions-project/sitekeep-ee-coordinate": "0.3.1",
    "@7dimensions-project/sitekeep-ee-cost": "0.6.2",
    "@7dimensions-project/sitekeep-ee-field": "0.3.3",
    "@7dimensions-project/sitekeep-ee-manage": "0.3.2",
    "@7dimensions-project/sitekeep-ee-planning": "0.3.1"
  },
  "devDependencies": {
    "@types/node": "^26.6.5",
    "@types/nodemailer": "^8.0.2",
    "@types/pg": "^8.23.1",
    "@types/three": "^0.186.0",
    "@types/yauzl": "^3.4.0",
    "@types/yazl": "^3.3.1",
    "drizzle-kit": "^0.31.11",
    "jszip": "3.10.1",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vitest": "^5.0.3"
  }
}
