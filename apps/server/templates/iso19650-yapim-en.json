{
  "format": "7d-cde/project-template@2",
  "name": {
    "en": "ISO 19650 Construction Project (multi-party, English names)",
    "tr": "ISO 19650 Yapım Projesi (çok taraflı, İngilizce adlarla)"
  },
  "description": {
    "en": "ISO 19650-1/-2 set-up for client, consultant, designer and contractor: a WIP area per party, internal check → review → authorize, shared areas for coordination and approval, publishing after consultant + designer review and client acceptance, archive. State transitions, task teams and unique document codes on. Document and correspondence naming, suitability and revision codes (S0–S4, A, B, CR; P01 / C01), roles, issue types, transmittals, RFI, material/method approval, meeting and form templates. Generalized from a live data-centre construction project.",
    "tr": "İdare, müşavir, tasarımcı ve yüklenici için ISO 19650-1/-2 düzeni: taraf başına çalışma alanı (WIP), iç kontrol (kontrol → gözden geçirme → yetkilendirme), koordinasyon ve onay için paylaşılan alanlar, müşavir + tasarımcı → idare kabulüyle yayınlama, arşiv. Durum geçişleri, görev ekipleri ve tekil doküman kodu açık. Doküman ve yazışma kodlaması, uygunluk ve revizyon kodları (S0–S4, A, B, CR; P01 / C01), roller, sorun tipleri, gönderim formu, RFI, malzeme/yöntem onayı, toplantı ve form şablonları. Canlıda çalışan bir veri merkezi yapım projesinin düzeninden genelleştirildi."
  },
  "language": "en",
  "family": "iso19650-yapim",
  "modules": {
    "correspondence": true,
    "rfi": true,
    "submittals": true,
    "meetings": true,
    "transmittals": true,
    "issues": true,
    "reviews": true,
    "forms": true,
    "coordination": true,
    "schedule": true,
    "spec": true,
    "reports": true
  },
  "cde": {
    "codeScheme": "iso_uk_na",
    "enforceTransitions": true,
    "wipPolicy": "team_only",
    "adminSeesWip": true,
    "archiveFolder": "40-ARCHIVED",
    "containerStandard": "ISO 19650 Document Naming",
    "taskTeams": [
      {
        "slot": "idare"
      },
      {
        "slot": "musavir"
      },
      {
        "slot": "tasarimci"
      },
      {
        "slot": "yuklenici",
        "lead": true
      }
    ],
    "transitions": [
      {
        "from": null,
        "to": "wip",
        "mode": "direct"
      },
      {
        "from": "wip",
        "to": "shared",
        "mode": "review"
      },
      {
        "from": "shared",
        "to": "wip",
        "mode": "auto"
      },
      {
        "from": "shared",
        "to": "published",
        "mode": "review",
        "workflow": "Approval: Consultant + Designer → Client acceptance → Publish"
      },
      {
        "from": "published",
        "to": "archived",
        "mode": "auto"
      }
    ]
  },
  "slots": [
    {
      "key": "idare",
      "label": {
        "en": "Client / Appointing party",
        "tr": "İdare / İşveren"
      },
      "party": "client",
      "code": "CLI",
      "description": {
        "en": "Appointing party; accepts information before it is published.",
        "tr": "Bilgiyi kabul eden taraf (appointing party). Yayınlamayı onaylar."
      }
    },
    {
      "key": "musavir",
      "label": {
        "en": "Consultant / Project manager",
        "tr": "Müşavir / Proje Yönetimi"
      },
      "party": "consultant",
      "code": "CON",
      "description": {
        "en": "Coordinates and checks on behalf of the client; RFI coordinator.",
        "tr": "İdare adına koordinasyon ve teknik kontrol; RFI koordinatörü."
      }
    },
    {
      "key": "tasarimci",
      "label": {
        "en": "Designer",
        "tr": "Tasarımcı"
      },
      "party": "designer",
      "code": "DES",
      "description": {
        "en": "Design and engineering team; answers RFIs and gives technical opinion on submittals.",
        "tr": "Tasarım ve mühendislik ekibi; RFI ve malzeme onaylarında teknik görüş verir."
      }
    },
    {
      "key": "yuklenici",
      "label": {
        "en": "Contractor",
        "tr": "Yüklenici"
      },
      "party": "contractor",
      "code": "CTR",
      "description": {
        "en": "Lead appointed party; authorizes and shares information.",
        "tr": "Baş yüklenici (lead appointed party); yetkilendirir ve paylaşır."
      }
    }
  ],
  "dimensions": {
    "Discipline": [
      "A",
      "S",
      "M",
      "E",
      "C",
      "L",
      "G",
      "I",
      "P",
