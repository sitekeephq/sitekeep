              "slot": "musavir",
              "level": "edit"
            }
          ]
        },
        {
          "name": "Designer",
          "state": "wip",
          "grants": [
            {
              "slot": "tasarimci",
              "level": "edit"
            }
          ],
          "skeleton": {
            "order": [
              "Discipline"
            ]
          }
        },
        {
          "name": "Contractor",
          "state": "wip",
          "grants": [
            {
              "slot": "yuklenici",
              "level": "edit"
            }
          ],
          "skeleton": {
            "order": [
              "Discipline"
            ]
          }
        }
      ]
    },
