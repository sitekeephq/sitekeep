  "workflows": [
    {
      "name": "Contractor internal check → share for approval",
      "kind": "review",
      "steps": [
        {
          "name": "Check",
          "assignees": [
            {
              "slot": "yuklenici"
            }
          ],
          "rule": "any",
          "days": 2,
          "outcomes": [
            "approved",
            "approved_with_comments",
            "revise_resubmit",
            "rejected"
          ],
          "requiredAttributes": [
            "Sheet / Document Title"
          ]
        },
        {
          "name": "Review",
          "assignees": [
            {
              "slot": "yuklenici"
            }
          ],
          "rule": "any",
          "days": 2,
          "outcomes": [
