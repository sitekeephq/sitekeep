{
  "format": "7d-cde/project-template@1",
  "name": "ISO 19650 Temel",
  "description": "Taraf başına çalışma (WIP) alanı, ortak paylaşılan alan (inceleme / onay), yayınlanan ve arşivlenen. Kodlama paylaşılan ve yayınlanan alanlarda zorunlu; dosyalar bu alanlara yalnız onaylı inceleme ile girer.",
  "modules": { "correspondence": true, "rfi": false, "submittals": false, "meetings": false, "transmittals": false, "issues": true, "reviews": true, "forms": false, "coordination": false, "schedule": false, "spec": false, "reports": true },
  "slots": [
    {
      "key": "idare",
      "label": "İdare",
      "party": "client",
      "code": "IDR",
      "description": "İşveren / idare: yayınlananı onaylar, her şeyi görür."
    },
    {
      "key": "musavir",
      "label": "Müşavir",
      "party": "consultant",
      "code": "MSV",
      "description": "Müşavir / danışman / kontrol: paylaşılanı inceler, inceleme adımlarında onaylar."
    },
    {
      "key": "tasarimci",
      "label": "Tasarımcı",
      "party": "designer",
      "code": "TSR",
      "description": "Tasarım firması: kendi çalışma alanında üretir, inceleme ile paylaşır."
    },
    {
      "key": "yuklenici",
      "label": "Yüklenici",
      "party": "contractor",
      "code": "YKL",
      "description": "Yüklenici: kendi alanında düzenler, tasarımı kontrol eder, idareye sunar."
    }
  ],
  "root": {
    "attributes": [
      "Revizyon",
      "Uygunluk Kodu"
    ]
  },
  "folders": [
    {
      "name": "01-WIP (Çalışmada)",
      "state": "wip",
      "children": [
        {
          "name": "İdare",
          "grants": [
            {
              "slot": "idare",
              "level": "edit"
            }
          ]
        },
        {
          "name": "Müşavir",
          "grants": [
            {
              "slot": "musavir",
              "level": "edit"
            }
          ]
        },
        {
          "name": "Tasarımcı",
          "grants": [
            {
              "slot": "tasarimci",
              "level": "edit"
            }
          ]
        },
        {
          "name": "Yüklenici",
          "grants": [
            {
              "slot": "yuklenici",
              "level": "edit"
            }
          ]
        }
      ]
    },
    {
      "name": "02-SHARED (Paylaşılan)",
      "state": "shared",
      "naming": "ISO 19650 Kodlama",
      "gate": true,
      "grants": [
        {
          "slot": "*",
          "level": "view_download_markup"
        }
      ],
      "children": [
        {
          "name": "01-İnceleme için",
          "state": "shared",
          "stateLabel": "İnceleme için"
        },
        {
          "name": "02-Onay için",
          "state": "shared",
          "stateLabel": "Onay için"
        }
      ]
    },
    {
      "name": "03-PUBLISHED (Yayınlanan)",
      "state": "published",
      "naming": "ISO 19650 Kodlama",
      "gate": true,
      "grants": [
        {
          "slot": "*",
          "level": "view_download"
        }
      ],
      "children": [
        {
          "name": "İş sonu",
          "state": "published",
          "stateLabel": "İş Sonu",
          "lazy": true
        }
      ]
    },
    {
      "name": "04-ARCHIVED (Arşiv)",
      "state": "archived",
      "grants": [
        {
          "slot": "idare",
          "level": "view_download"
        }
      ]
    }
  ],
  "namingStandards": [
    {
      "name": "ISO 19650 Kodlama",
      "delimiter": "-",
      "fields": [
        {
          "name": "Proje",
          "type": "list",
          "values": [
            {
              "code": "{PROJE}",
              "description": "Proje kodu"
            }
          ]
        },
        {
          "name": "Kaynak",
          "type": "list",
          "values": [
            {
              "code": "{slot:idare}",
              "description": "{firma:idare}"
            },
            {
              "code": "{slot:musavir}",
              "description": "{firma:musavir}"
            },
            {
              "code": "{slot:tasarimci}",
              "description": "{firma:tasarimci}"
            },
            {
              "code": "{slot:yuklenici}",
              "description": "{firma:yuklenici}"
            }
          ]
        },
        {
