  ],
  "attributes": [
    {
      "name": "Revizyon",
      "type": "text"
    },
    {
      "name": "Uygunluk Kodu",
      "type": "list",
      "options": [
        "S0",
        "S1",
        "S2",
        "S3",
        "S4",
        "A1",
        "A2",
        "A3",
        "B1",
        "CR"
      ]
    }
  ],
  "workflows": [
    {
      "name": "Tasarımcı → Müşavir → İdare",
      "kind": "review",
      "steps": [
        {
          "name": "Müşavir İncelemesi",
          "assignees": [
            {
              "slot": "musavir"
            }
          ],
          "rule": "any",
          "days": 15,
          "outcomes": [
            "approved",
            "approved_with_comments",
            "reviewed",
            "revise_resubmit",
            "rejected"
          ]
        },
        {
          "name": "İdare Onayı",
          "assignees": [
            {
              "slot": "idare"
            }
          ],
          "rule": "any",
          "days": 30,
          "outcomes": [
            "approved",
            "approved_with_comments",
            "rejected"
          ]
        }
      ]
    },
    {
      "name": "Ekip İçi Kontrol",
      "kind": "review",
      "steps": [
        {
          "name": "Proje Yöneticisi Kontrolü",
          "assignees": [
            {
              "role": "project_admin"
            }
          ],
          "rule": "any",
          "days": 5,
          "outcomes": [
            "approved",
            "approved_with_comments",
            "revise_resubmit"
          ]
        }
      ]
    }
  ]
}
