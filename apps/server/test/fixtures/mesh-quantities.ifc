ENDSEC;
DATA;
#1=IFCPERSON($,'Test',$,$,$,$,$,$);
#2=IFCORGANIZATION($,'7Dimensions',$,$,$);
#3=IFCPERSONANDORGANIZATION(#1,#2,$);
#4=IFCAPPLICATION(#2,'0.1','7d-cde fixture','7DCDE');
#5=IFCOWNERHISTORY(#3,#4,$,.ADDED.,$,$,$,1760000000);
#10=IFCCARTESIANPOINT((0.,0.,0.));
#11=IFCDIRECTION((0.,0.,1.));
#12=IFCDIRECTION((1.,0.,0.));
#13=IFCAXIS2PLACEMENT3D(#10,#11,#12);
#14=IFCGEOMETRICREPRESENTATIONCONTEXT($,'Model',3,1.E-05,#13,$);
#15=IFCGEOMETRICREPRESENTATIONSUBCONTEXT('Body','Model',*,*,*,*,#14,$,.MODEL_VIEW.,$);
#20=IFCSIUNIT(*,.LENGTHUNIT.,.MILLI.,.METRE.);
#21=IFCSIUNIT(*,.AREAUNIT.,$,.SQUARE_METRE.);
#22=IFCSIUNIT(*,.VOLUMEUNIT.,$,.CUBIC_METRE.);
#23=IFCSIUNIT(*,.PLANEANGLEUNIT.,$,.RADIAN.);
#24=IFCUNITASSIGNMENT((#20,#21,#22,#23));
#30=IFCPROJECT('0MqProj000000000000001',#5,'Geometri Metraji',$,$,$,$,(#14),#24);
#40=IFCLOCALPLACEMENT($,#13);
#41=IFCSITE('0MqSite000000000000001',#5,'Saha',$,$,#40,$,$,.ELEMENT.,$,$,$,$,$);
#42=IFCLOCALPLACEMENT(#40,#13);
#43=IFCBUILDING('0MqBina000000000000001',#5,'Bina',$,$,#42,$,$,.ELEMENT.,$,$,$);
#44=IFCLOCALPLACEMENT(#42,#13);
#45=IFCBUILDINGSTOREY('0MqKat0000000000000000',#5,'Zemin Kat',$,$,#44,$,$,.ELEMENT.,0.);
#50=IFCRELAGGREGATES('0MqAgg0000000000000001',#5,$,$,#30,(#41));
#51=IFCRELAGGREGATES('0MqAgg0000000000000002',#5,$,$,#41,(#43));
#52=IFCRELAGGREGATES('0MqAgg0000000000000003',#5,$,$,#43,(#45));
#60=IFCCARTESIANPOINT((0.,0.));
#61=IFCDIRECTION((1.,0.));
#62=IFCAXIS2PLACEMENT2D(#60,#61);
#70=IFCLOCALPLACEMENT(#44,#13);
/* Wall profile 5000 x 300 (centred), extruded 3000: 4.5 m3, one side 15 m2. */
#63=IFCRECTANGLEPROFILEDEF(.AREA.,'Duvar',#62,5000.,300.);
#64=IFCEXTRUDEDAREASOLID(#63,#13,#11,3000.);
#65=IFCSHAPEREPRESENTATION(#15,'Body','SweptSolid',(#64));
#66=IFCPRODUCTDEFINITIONSHAPE($,$,(#65));
#67=IFCPRODUCTDEFINITIONSHAPE($,$,(#65));
#68=IFCPRODUCTDEFINITIONSHAPE($,$,(#65));
/* Duvar-1: no quantity sets at all. */
#100=IFCWALL('0MqWall000000000000001',#5,'Duvar-1',$,$,#70,#66,$,.STANDARD.);
/* Duvar-2: no quantity sets; a 1000 x 2000 opening cuts through it (0.6 m3, 2 m2 of the side). */
#200=IFCWALL('0MqWall000000000000002',#5,'Duvar-2',$,$,#70,#67,$,.STANDARD.);
#210=IFCRECTANGLEPROFILEDEF(.AREA.,'Kapi Boslugu',#62,1000.,400.);
#211=IFCEXTRUDEDAREASOLID(#210,#13,#11,2000.);
#212=IFCSHAPEREPRESENTATION(#15,'Body','SweptSolid',(#211));
#213=IFCPRODUCTDEFINITIONSHAPE($,$,(#212));
#214=IFCOPENINGELEMENT('0MqOpen000000000000001',#5,'Bosluk',$,$,#70,#213,$,.OPENING.);
#215=IFCRELVOIDSELEMENT('0MqVoid000000000000001',#5,$,$,#200,#214);
/* Duvar-3: the base quantities have a volume only; it is not measured from the geometry. */
#300=IFCWALL('0MqWall000000000000003',#5,'Duvar-3',$,$,#70,#68,$,.STANDARD.);
#301=IFCQUANTITYVOLUME('NetVolume',$,$,4.4,$);
#302=IFCELEMENTQUANTITY('0MqQto0000000000000W03',#5,'Qto_WallBaseQuantities',$,$,(#301));
#303=IFCRELDEFINESBYPROPERTIES('0MqRel0000000000000W03',#5,$,$,(#300),#302);
/* Doseme-1: 5000 x 4000 x 200, no quantity sets: 4 m3, 20 m2 (plan). */
#400=IFCRECTANGLEPROFILEDEF(.AREA.,'Doseme',#62,5000.,4000.);
#401=IFCEXTRUDEDAREASOLID(#400,#13,#11,200.);
#402=IFCSHAPEREPRESENTATION(#15,'Body','SweptSolid',(#401));
#403=IFCPRODUCTDEFINITIONSHAPE($,$,(#402));
#404=IFCSLAB('0MqSlab000000000000001',#5,'Doseme-1',$,$,#70,#403,$,.FLOOR.);
/* Kolon-1: full base quantities; nothing is computed. */
#500=IFCCOLUMN('0MqColu000000000000001',#5,'Kolon-1',$,$,#70,#403,$,.COLUMN.);
#501=IFCQUANTITYVOLUME('NetVolume',$,$,1.,$);
#502=IFCQUANTITYAREA('NetSurfaceArea',$,$,2.,$);
#503=IFCQUANTITYAREA('NetArea',$,$,2.,$);
#504=IFCELEMENTQUANTITY('0MqQto0000000000000C01',#5,'Qto_ColumnBaseQuantities',$,$,(#501,#502,#503));
#505=IFCRELDEFINESBYPROPERTIES('0MqRel0000000000000C01',#5,$,$,(#500),#504);
#900=IFCRELCONTAINEDINSPATIALSTRUCTURE('0MqRel0000000000000C10',#5,$,$,(#100,#200,#300,#404,#500),#45);
ENDSEC;
END-ISO-10303-21;
