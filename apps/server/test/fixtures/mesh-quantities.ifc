ISO-10303-21;
HEADER;
FILE_DESCRIPTION(('ViewDefinition [ReferenceView]'),'2;1');
FILE_NAME('mesh-quantities.ifc','2026-11-08T10:00:00',('7Dimensions'),('7Dimensions'),'','7d-cde test fixture','');
