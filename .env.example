# docker compose settings — copy to .env and change every value.
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=change-me-at-least-10-chars
POSTGRES_PASSWORD=change-me-too
# Image (docker compose pulls it). SiteKeep Community by default; for SiteKeep Enterprise:
#   SITEKEEP_IMAGE=ghcr.io/sitekeephq/sitekeep-enterprise
SITEKEEP_IMAGE=ghcr.io/sitekeephq/sitekeep
# A release (1.0.0) or latest
SITEKEEP_VERSION=latest
# Only when building from source (docker-compose.build.yml): community or enterprise, and a GitHub
# token with read:packages for the private packages.
#SITEKEEP_EDITION=community
#NODE_AUTH_TOKEN=github-package-read-token
# Port on the host
CDE_PORT=8080
# 1 when the app is served over HTTPS (reverse proxy)
SECURE_COOKIES=0

# --- Office integration (optional, docs/features/OFIS_ENTEGRASYONU.md) ---------------------------------
# Leave empty to configure later in Yönetim → Office entegrasyonu. Uncomment ONE block and start
# compose with the matching profile, e.g.  docker compose --profile onlyoffice up -d
#
# ONLYOFFICE Docs (editing + PDF):
#CDE_OFFICE_EDITOR=onlyoffice
#CDE_OFFICE_EDITOR_URL=http://onlyoffice
#CDE_OFFICE_EDITOR_PUBLIC_URL=http://SERVER-NAME:8081
#ONLYOFFICE_JWT_SECRET=change-me-long-random-secret
#
# Collabora Online (editing + PDF):
#CDE_OFFICE_EDITOR=collabora
#CDE_OFFICE_EDITOR_URL=http://collabora:9980
#COLLABORA_SERVER_NAME=SERVER-NAME:9980
#COLLABORA_ADMIN_PASSWORD=change-me
# Browser host of the CDE (may embed the Collabora frame), e.g. cde.example.com or SERVER-NAME:*
#CDE_PUBLIC_HOST=SERVER-NAME:*
#
# Gotenberg (PDF only):
#CDE_OFFICE_CONVERTER=gotenberg
#CDE_OFFICE_CONVERTER_URL=http://gotenberg:3000
#
# CDE address as the office containers reach it (default http://app:8080)
#CDE_WOPI_BASE_URL=http://app:8080

# Optional Google OAuth 2.0 Web application.
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
# GOOGLE_CALLBACK_URL=http://localhost:5173/api/v1/auth/google/callback

# Behind a reverse proxy (nginx, Caddy, IIS): "1" or its addresses/CIDRs, so the client IP and HTTPS
# come from X-Forwarded-* (sign-in limits, logs). The on-prem bundle sets it (docs/onprem/kurulum-paketi.md).
# CDE_TRUST_PROXY=1

# Optional Autodesk APS / ACC read-only synchronization (PKCE).
# Register this exact callback in the APS application.
# AUTODESK_CLIENT_ID=
# AUTODESK_CALLBACK_URL=http://localhost:5173/api/v1/integrations/autodesk/callback
# Only for an APS "Traditional Web App" (it has a secret); leave empty for a PKCE-only app.
# AUTODESK_CLIENT_SECRET=
